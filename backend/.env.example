# Configurações do Servidor
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Chaves de API para Inteligência Artificial (Opcional - mas recomendado para IA Máxima)
# 1. GROQ (Grátis, rápido e excelente com Llama 3.3 70B): https://console.groq.com/keys
GROQ_API_KEY=

# 2. GEMINI (Grátis e oficial do Google): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. OPENAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
